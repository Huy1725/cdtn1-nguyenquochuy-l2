        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam defaultFontName \&quot;Arial\&quot;\nskinparam linetype ortho\nhide circle\n\nentity \&quot;customer\&quot; as customer {\n  * customer_id : BIGSERIAL [PK]\n  --\n  full_name : VARCHAR(120)\n  phone : VARCHAR(20) [UNIQUE]\n  email : VARCHAR(120)\n  segment : VARCHAR(20)\n  created_at : TIMESTAMPTZ\n}\n\nentity \&quot;device\&quot; as device {\n  * device_id : BIGSERIAL [PK]\n  --\n  customer_id : BIGINT [FK]\n  serial_no : VARCHAR(50) [UNIQUE]\n  purchase_date : DATE\n  warranty_months : INT\n}\n\nentity \&quot;technician\&quot; as technician {\n  * technician_id : BIGSERIAL [PK]\n  --\n  employee_id : VARCHAR(20)\n  center_id : BIGINT\n  level : VARCHAR(20)\n  is_active : BOOLEAN\n}\n\nentity \&quot;ticket\&quot; as ticket {\n  * ticket_id : BIGSERIAL [PK]\n  --\n  ticket_code : VARCHAR(20) [UNIQUE]\n  customer_id : BIGINT [FK, NOT NULL]\n  device_id : BIGINT [FK, NOT NULL]\n  technician_id : BIGINT [FK, NULL được]\n  category_id : INT [FK, NULL được]\n  issue_desc : TEXT [NOT NULL]\n  priority : VARCHAR(20) [NOT NULL]\n  status : VARCHAR(12) [NOT NULL]\n  received_at : TIMESTAMPTZ [NOT NULL]\n  due_date : TIMESTAMPTZ [NOT NULL]\n}\n\nentity \&quot;ticket_status_log\&quot; as ticket_status_log {\n  * log_id : BIGSERIAL [PK]\n  --\n  ticket_id : BIGINT [FK, NOT NULL]\n  from_status : VARCHAR(12) [NULL được]\n  to_status : VARCHAR(12) [NOT NULL]\n  changed_at : TIMESTAMPTZ [NOT NULL]\n  changed_by : BIGINT [FK, NOT NULL]\n}\n\ncustomer ||--o{ device\ncustomer ||--o{ ticket\ndevice ||--o{ ticket\ntechnician |o--o{ ticket\nticket ||--o{ ticket_status_log\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="lIbbZd4YYIC51x5LxnuL-1">
