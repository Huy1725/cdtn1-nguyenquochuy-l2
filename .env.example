# Copy this file to .env, then start:
#   macOS/Linux/Git Bash:  cp .env.example .env
#   Windows cmd:           copy .env.example .env
# NEVER commit .env (it is in .gitignore). Change every value below for a real deployment.
# Each variable is explained in docs/deployment-guide.md.

# --- Used by Docker Compose AND by "npm start" ---

# MySQL password. Compose sets it as the root password of the database container;
# with "npm start" it is the password of your own MySQL account.
DB_PASSWORD=change-me-db-password

# Key used to sign login tokens. At least 32 characters; the app refuses to start otherwise.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters

# Database name.
DB_NAME=warranty_l2

# --- Docker Compose only ---

# Port of the app on YOUR machine. Change it if port 3000 is already taken.
APP_PORT=3000

# --- "npm start" without Docker only (Compose overrides DB_HOST, DB_PORT, DB_USER and PORT) ---

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
PORT=3000

# Browser origin allowed by CORS. Only needed when the UI runs on another origin (npm run dev).
CORS_ORIGIN=http://localhost:5173

# Frontend dev server (npm run dev): API address; leave empty to use the Vite proxy.
VITE_API_BASE_URL=http://localhost:3000
